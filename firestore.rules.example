// Production-style rules — see /firestore.rules (currently open for FYP dev).
// To restore: copy a backed-up strict rules file or git history, then:
//   npm run firebase:deploy:rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
