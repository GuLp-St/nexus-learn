rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AI config: readable by signed-in users (server uses env fallback if empty).
    // Writes: restrict to admins in production. For FYP dev, you can allow authenticated writes:
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
