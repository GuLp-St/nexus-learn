# =============================================================================
# Copy this file to `.env.local` for local dev.
# Add the SAME variable names in Vercel → Project → Settings → Environment Variables
# (use Production + Preview + Development as needed).
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (required — client-side, NEXT_PUBLIC_*)
# From Firebase Console → Project settings → Your apps → Web app config
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Gemini — TEXT only (chat, courses, lessons, quizzes)
# Only the API key(s) are needed (no account id).
# -----------------------------------------------------------------------------
# One key for all Gemini text (chat, courses, lessons, quizzes):
NEXT_PUBLIC_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Cloudflare Workers AI — IMAGES (course covers, lesson illustrations)
# Each token MUST belong to the accountId it is paired with.
# -----------------------------------------------------------------------------

# Option A — One account, one or more tokens on THAT account (simplest):
CLOUDFLARE_ACCOUNT_ID=136a5986d82d3cf6e925ce74eb7c9644
CLOUDFLARE_API_TOKEN=
# Extra tokens on the SAME account (comma-separated, no spaces):
# CLOUDFLARE_API_TOKENS=token2,token3

# Option B — Multiple account+token pairs (different Cloudflare accounts):
# One-line JSON array (paste in Vercel as single line):
# CLOUDFLARE_ACCOUNTS_JSON=[{"accountId":"136a5986d82d3cf6e925ce74eb7c9644","apiToken":"YOUR_TOKEN"},{"accountId":"OTHER_ACCOUNT_ID","apiToken":"OTHER_TOKEN"}]

CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# -----------------------------------------------------------------------------
# Uploadthing (file uploads — course materials, generated images)
# From uploadthing.com dashboard → API Keys
# -----------------------------------------------------------------------------
UPLOADTHING_TOKEN=

# -----------------------------------------------------------------------------
# Unsplash (optional — stock photos in image picker / fallback covers)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Firestore seed script only (local — NOT needed on Vercel)
# Download from Firebase → Project settings → Service accounts → Generate key
# -----------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# -----------------------------------------------------------------------------
# REMOVE from Vercel (unused in codebase):
# HUGGINGFACE_API_KEY
# -----------------------------------------------------------------------------
