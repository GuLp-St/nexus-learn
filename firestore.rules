rules_version = '2';

// FYP / development only — open read/write for all clients (deployed 2026-06-03).
// Do NOT use in production. Replace with firestore.rules.example + docs/FIRESTORE_SECURITY.md before shipping.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
